# ==========================================
# 1. Database Configuration (PostgreSQL)
# ==========================================
# Local SQLite fallback (default for quick testing):
DATABASE_URL=sqlite+aiosqlite:///./cold_storage.db

# Production PostgreSQL Connection:
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/coldstorage_db

# ==========================================
# 2. Redis Configuration (Live Cache & Locks)
# ==========================================
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=true
REDIS_METRICS_TTL_SECONDS=15

# ==========================================
# 3. SMS Chef Gateway (https://smschef.com)
# ==========================================
# 1. Register account & install SMS Chef app on your Android phone
# 2. Get API Secret Key from Tools -> API Keys
# 3. Get Device ID from Devices section
SMSCHEF_API_URL=https://www.cloud.smschef.com/api/send/sms
SMSCHEF_API_KEY=your_smschef_secret_api_key_here
SMSCHEF_DEVICE_ID=your_device_id_here
SMSCHEF_SIM_SLOT=1

# ==========================================
# 4. Alert Debounce & Simulation
# ==========================================
ENABLE_SMS_SIMULATION=true
ALERT_DEBOUNCE_MINUTES=5
